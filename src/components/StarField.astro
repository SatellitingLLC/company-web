---

---

<div class="fixed inset-0 z-0 overflow-hidden pointer-events-none">
  <canvas id="starfield" class="absolute inset-0 w-full h-full"></canvas>

  <div
    class="absolute top-1/4 -left-32 w-96 h-96 bg-nebula-cyan/10 rounded-full blur-3xl"
  >
  </div>
  <div
    class="absolute bottom-1/4 -right-32 w-96 h-96 bg-aurora-green/10 rounded-full blur-3xl"
  >
  </div>
</div>

<script>
  const canvas = document.getElementById("starfield") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;

  let stars: Array<{
    angle: number;
    radius: number;
    speed: number;
    size: number;
  }> = [];
  let shootingStars: Array<{
    x: number;
    y: number;
    vx: number;
    vy: number;
    life: number;
    initialLife: number;
  }> = [];
  const numStars = 200;
  let animationId: number;

  function resizeCanvas() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    initStars();
  }

  function initStars() {
    const maxRadius = Math.sqrt(canvas.width ** 2 + canvas.height ** 2);
    stars = Array.from({ length: numStars }, () => ({
      angle: Math.random() * Math.PI * 2,
      radius: Math.random() * maxRadius,
      speed: Math.random() * 0.0002 + 0.0001,
      size: Math.random() * 1.2 + 0.4,
    }));
  }

  function spawnShootingStar() {
    if (shootingStars.length === 0 && Math.random() < 0.008) {
      shootingStars.push({
        x: Math.random() * canvas.width * 0.6,
        y: Math.random() * canvas.height * 0.4,
        vx: 4 + Math.random() * 3,
        vy: 1.5 + Math.random() * 2,
        life: 60,
        initialLife: 60,
      });
    }
  }

  function animate() {
    const centerX = canvas.width * 0.5;
    const centerY = canvas.height * 0.5;

    // Clear with space gradient
    const gradient = ctx.createLinearGradient(
      0,
      0,
      canvas.width,
      canvas.height
    );
    gradient.addColorStop(0, "#0a0e17");
    gradient.addColorStop(0.5, "#1a2332");
    gradient.addColorStop(1, "#0f172a");
    ctx.fillStyle = gradient;
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Draw orbiting stars
    stars.forEach((star, i) => {
      star.angle += star.speed;
      const x = centerX + star.radius * Math.cos(star.angle);
      const y = centerY + star.radius * Math.sin(star.angle);

      // Skip if off screen
      if (x < -10 || x > canvas.width + 10 || y < -10 || y > canvas.height + 10)
        return;

      const flicker = 0.3 + Math.abs(Math.sin(Date.now() * 0.001 + i)) * 0.5;

      ctx.beginPath();
      ctx.fillStyle = `rgba(255, 255, 255, ${flicker})`;
      ctx.arc(x, y, star.size, 0, Math.PI * 2);
      ctx.fill();
    });

    // Handle shooting stars
    spawnShootingStar();
    for (let i = shootingStars.length - 1; i >= 0; i--) {
      const s = shootingStars[i];
      const opacity = s.life / s.initialLife;

      const grad = ctx.createLinearGradient(
        s.x,
        s.y,
        s.x - s.vx * 30,
        s.y - s.vy * 30
      );
      grad.addColorStop(0, `rgba(6, 182, 212, ${opacity})`);
      grad.addColorStop(0.3, `rgba(255, 255, 255, ${opacity * 0.8})`);
      grad.addColorStop(1, `rgba(6, 182, 212, 0)`);

      ctx.strokeStyle = grad;
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(s.x, s.y);
      ctx.lineTo(s.x - s.vx * 15, s.y - s.vy * 15);
      ctx.stroke();

      s.x += s.vx;
      s.y += s.vy;
      s.life -= 1;

      if (s.life <= 0) shootingStars.splice(i, 1);
    }

    animationId = requestAnimationFrame(animate);
  }

  window.addEventListener("resize", resizeCanvas);
  resizeCanvas();
  animate();

  // Cleanup on page navigation
  document.addEventListener("astro:before-swap", () => {
    cancelAnimationFrame(animationId);
  });
</script>
