---
const navLinks = [
  { href: "/", label: "Home", icon: "home" },
  { href: "/about", label: "About", icon: "info" },
  { href: "/projects", label: "Projects", icon: "rocket" },
  { href: "/contact", label: "Contact", icon: "mail" },
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 glass">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <a href="/" class="flex items-center gap-3 group">
        <div class="relative w-10 h-10 md:w-12 md:h-12">
          <div
            class="absolute inset-0 bg-gradient-to-br from-nebula-cyan to-aurora-green rounded-full opacity-20 group-hover:opacity-40 transition-opacity"
          >
          </div>
          <img
            src="/logo.png"
            alt="Satelliting"
            class="w-full h-full object-contain relative z-10"
          />
        </div>
        <span
          class="hidden sm:block text-lg md:text-xl font-display font-semibold bg-gradient-to-r from-white to-gray-300 bg-clip-text text-transparent"
        >
          Satelliting
        </span>
      </a>

      <ul class="flex items-center gap-1 md:gap-2">
        {
          navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "btn-ghost text-sm md:text-base",
                  currentPath === link.href &&
                    "text-nebula-cyan bg-nebula-cyan/10",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<div class="h-16 md:h-20"></div>
