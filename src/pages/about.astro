---
import BaseLayout from "../layouts/BaseLayout.astro";

const differentiators = [
  {
    icon: "rocket",
    title: "Launch-ready strategy",
    description:
      "We translate ambitious goals into phased rollout plans that keep stakeholders aligned and momentum high.",
    tags: ["Strategy", "Roadmapping", "Analytics"],
  },
  {
    icon: "users",
    title: "Human-centered build",
    description:
      "Research-led sprints turn user insight into intuitive flows and polished component systems.",
    tags: ["Design", "UX", "Accessibility"],
  },
  {
    icon: "chart",
    title: "Performance obsessed",
    description:
      "Every deployment is tuned for speed, accessibility, and long-term maintainability across the stack.",
    tags: ["Optimization", "Reliability", "Monitoring"],
  },
  {
    icon: "globe",
    title: "Remote collaboration",
    description:
      "Productive async rituals keep progress clear no matter the timezone, without sacrificing partnership.",
    tags: ["Async", "Operations", "Transparency"],
  },
];

const values = [
  {
    icon: "handshake",
    title: "Partnership over projects",
    description:
      "We treat every engagement as a shared mission, embedding with your team to build trust and transparency.",
  },
  {
    icon: "shield",
    title: "Quality without compromise",
    description:
      "From documentation to design QA, we uphold standards that safeguard your brand and your roadmap.",
  },
];

const phases = [
  {
    title: "Orbit mapping",
    description: "Align on goals, audiences, and success measures.",
  },
  {
    title: "Prototype sprint",
    description: "Validate interaction models with live stakeholders.",
  },
  {
    title: "Launch build",
    description:
      "Ship production-ready experiences with observability baked in.",
  },
  {
    title: "Continuous lift",
    description:
      "Optimize through experiments, content updates, and iterative releases.",
  },
];
---

<BaseLayout
  title="About"
  description="Learn about Satelliting LLC - A studio dedicated to building digital gravity for visionary brands."
>
  <section class="py-24 relative">
    <div class="absolute inset-0 bg-nebula-glow opacity-50"></div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span
            class="text-nebula-cyan text-sm font-semibold uppercase tracking-widest"
            >About Satelliting</span
          >
          <h1 class="section-heading text-4xl md:text-5xl mt-4 leading-tight">
            A studio dedicated to building digital gravity for visionary brands
          </h1>
        </div>
        <div>
          <p class="text-xl text-gray-300 leading-relaxed">
            Satelliting LLC is a remote-first product team specializing in
            modern web experiences. We partner with founders and marketing
            leaders to bring new ideas to orbit and keep mature products
            responsive to market shifts.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 md:grid-cols-2">
        {
          differentiators.map((item, index) => (
            <div class="card-space p-8 group">
              <div class="flex items-start gap-6">
                <div class="flex-shrink-0 w-14 h-14 rounded-2xl bg-gradient-to-br from-nebula-cyan to-aurora-green flex items-center justify-center text-space-900">
                  {item.icon === "rocket" && (
                    <svg
                      class="w-6 h-6"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 10V3L4 14h7v7l9-11h-7z"
                      />
                    </svg>
                  )}
                  {item.icon === "users" && (
                    <svg
                      class="w-6 h-6"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
                      />
                    </svg>
                  )}
                  {item.icon === "chart" && (
                    <svg
                      class="w-6 h-6"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"
                      />
                    </svg>
                  )}
                  {item.icon === "globe" && (
                    <svg
                      class="w-6 h-6"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                      />
                    </svg>
                  )}
                </div>
                <div class="flex-1">
                  <div class="flex items-center justify-between mb-3">
                    <h3 class="text-2xl font-display font-semibold text-white group-hover:text-nebula-cyan transition-colors">
                      {item.title}
                    </h3>
                    <span class="text-sm font-mono text-nebula-cyan/50">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                  </div>
                  <p class="text-gray-400 mb-4">{item.description}</p>
                  <div class="flex flex-wrap gap-2">
                    {item.tags.map((tag, tagIndex) => (
                      <span
                        class:list={[
                          "px-3 py-1 text-xs font-medium rounded-full",
                          tagIndex === 0
                            ? "bg-nebula-cyan/20 text-nebula-cyan"
                            : "bg-white/5 text-gray-400",
                        ]}
                      >
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-24 relative">
    <div class="absolute inset-0 bg-aurora-gradient"></div>
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid lg:grid-cols-[2fr_3fr] gap-12">
        <div class="space-y-8">
          <h2 class="section-heading text-3xl">Our operating rhythm</h2>
          <p class="text-gray-300">
            Each engagement is anchored by discovery workshops and a shared
            roadmap. Weekly async updates, recorded demos, and transparent
            metrics keep decision-makers in the loop without crowding calendars.
          </p>

          <div class="card-space p-6">
            <h3 class="text-xl font-display font-semibold text-white mb-6">
              Launch phases
            </h3>
            <div class="space-y-4">
              {
                phases.map((phase) => (
                  <div class="flex items-start gap-4">
                    <span class="mt-2 w-2 h-2 rounded-full bg-nebula-cyan flex-shrink-0" />
                    <div>
                      <span class="font-semibold text-white">
                        {phase.title}.
                      </span>
                      <span class="text-gray-400"> {phase.description}</span>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
          {
            values.map((item) => (
              <div class="card-space p-6">
                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-nebula-cyan to-aurora-green flex items-center justify-center text-space-900 mb-4">
                  {item.icon === "handshake" && (
                    <svg
                      class="w-5 h-5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5v-1a1.5 1.5 0 013 0v1m0 0V11m0-5.5a1.5 1.5 0 013 0v3m0 0V11"
                      />
                    </svg>
                  )}
                  {item.icon === "shield" && (
                    <svg
                      class="w-5 h-5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                      />
                    </svg>
                  )}
                </div>
                <h3 class="text-xl font-display font-semibold text-white mb-2">
                  {item.title}
                </h3>
                <p class="text-gray-400">{item.description}</p>
              </div>
            ))
          }

          <div
            class="card-space p-6 border-dashed border-nebula-cyan/50 md:col-span-2"
          >
            <h3 class="text-xl font-display font-semibold text-white mb-2">
              Leadership collective
            </h3>
            <p class="text-gray-400 mb-2">
              Strategists, designers, and engineers with a decade of shipping
              enterprise-grade platforms and consumer apps rally around each
              launch.
            </p>
            <p class="text-gray-500 text-sm">
              We assemble tailored squads so you gain the exact expertise needed
              without long hiring cycles.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div
        class="card-space p-12 text-center bg-gradient-to-br from-nebula-cyan/20 to-aurora-green/10"
      >
        <h2 class="section-heading text-3xl mb-6">
          Let's co-create your next release
        </h2>
        <p class="text-gray-300 text-lg mb-8 max-w-2xl mx-auto">
          Share your roadmap and we'll map the delivery window, success metrics,
          and team you need to make it real.
        </p>
        <a href="/contact" class="btn-primary text-lg"> Plan a conversation </a>
      </div>
    </div>
  </section>
</BaseLayout>
